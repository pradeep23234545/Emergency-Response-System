{
  "name": "@corridor/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Corridor API: simulation engine, REST endpoints and live event stream.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@corridor/core": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/supertest": "^6.0.3",
    "esbuild": "0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.4",
    "thread-stream": "3.1.0",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4"
  }
}
