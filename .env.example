# Copy to .env and adjust. All values are optional in development.

# API server
PORT=8080
NODE_ENV=development
# SQLite file (created automatically)
# DATABASE_PATH=./data/corridor.db
SESSION_TTL_HOURS=12
ALLOW_SIGNUP=true
SIM_SEED=20260
# Comma separated origins, only needed when the web app is served from another origin
# CORS_ORIGIN=http://localhost:5173

# Demo administrator created on first start when the database has no users.
# Local development credentials only - change before any shared deployment.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Corridor@2026

# Web client (Vite)
WEB_PORT=5173
API_PROXY_TARGET=http://localhost:8080
